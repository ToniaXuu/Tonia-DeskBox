<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 不打开 UseWindowsForms：托盘图标由 Services/TrayIcon.cs 直接走 Shell_NotifyIcon，
         屏幕与光标坐标由 Services/ScreenUtil.cs 走 MonitorFromWindow / GetCursorPos。
         注意：单文件体积不会因此变小（WinForms 与 WPF 同在 WindowsDesktop 共享框架里），
         收益是运行时不再加载 WinForms / System.Drawing 这两套程序集。 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ToniaDeskBox</RootNamespace>
    <AssemblyName>ToniaDeskBox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- 版本号是更新检查的唯一依据：安装包文件名、Release 标签、
         程序内「关于」三处必须一致，改版本只需改这一行 + installer 里的同名默认值。
         AssemblyVersion / FileVersion / InformationalVersion 全部由它推导，
         这样 CI 用 -p:Version=x.y.z 注入时，文件属性也会跟着变。 -->
    <Version>0.3.1</Version>
    <Product>Tonia-DeskBox</Product>
    <AssemblyTitle>Tonia-DeskBox</AssemblyTitle>
    <Description>桌面盒子整理工具</Description>
    <Company>Tonia</Company>
    <Copyright>Copyright © 2026 Tonia</Copyright>

    <!-- 默认会在 InformationalVersion 后面拼 "+提交哈希"，更新检查要按语义版本比较，
         这里关掉，保证 AssemblyInformationalVersion 就是干净的 0.3.1 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发工具（离屏渲染 / 验证）需要读取内部状态做断言，比如面板是否因重叠转成不透明。
         只放行这两个工具程序集，产品代码不对外暴露。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ScreenshotKit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ToniaDeskBox.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico 只用于编译期写入 exe 的 Win32 图标，固定浅色版 -->
    <Resource Include="app.ico" />
    <!-- 运行时主题图标：按系统 AppsUseLightTheme 在浅/深色之间切换 -->
    <Resource Include="Assets\app-*.ico" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 自带运行时：装机用户不必预装 .NET 桌面运行时，安装包才能「双击即可用」 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 原生库一起塞进单文件，否则 exe 旁边还会散落一堆 dll，安装/升级都不干净 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件压缩：146MB → 约 60MB，更新下载量与安装包体积都受益 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
