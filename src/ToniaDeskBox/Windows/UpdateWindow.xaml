<Window x:Class="ToniaDeskBox.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Icon="{DynamicResource AppIcon}"
        Width="486"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <!-- 与其它窗口共用 Theme.* 笔刷，不在这里硬编码任何前景色 -->
    <Grid Margin="24">
        <Border x:Name="ShadowCaster" CornerRadius="14"
                Background="{DynamicResource Theme.ShadowFill}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource Theme.Surface}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top"
                           Margin="10,0,10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Theme.Accent}"
                           IsHitTestVisible="False"/>

                <Border Grid.Row="0" Background="{DynamicResource Theme.TitleBar}"
                        CornerRadius="13,13,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                     Fill="{DynamicResource Theme.Accent}"/>
                            <Image Source="{DynamicResource AppIcon}" Width="18" Height="18"/>
                            <TextBlock Text="检查更新" Foreground="{DynamicResource Theme.Text}"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Click="OnClose" Cursor="Hand" ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{DynamicResource Theme.Icon}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Danger}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,16,20,18">

                    <!-- 状态标题 + 当前版本 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="正在检查更新…"
                                   FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Text}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1" Margin="14,0,0,0"
                                   FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="DetailText" Text="正在从 GitHub 获取最新版本信息…"
                               FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               Margin="0,0,0,14"/>

                    <!-- 更新说明：内容来自 Release，长度不可控，必须可滚动 -->
                    <Border x:Name="NotesPanel" Visibility="Collapsed"
                            Background="{DynamicResource Theme.Fill}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="12,10" Margin="0,0,0,14" MaxHeight="148">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NotesText" FontSize="12" LineHeight="19"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 下载进度 -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <ProgressBar x:Name="UpdateBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                     BorderThickness="0" Background="Transparent">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="{DynamicResource Theme.FillStrong}" CornerRadius="3"/>
                                        <Border x:Name="PART_Track"/>
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                Background="{DynamicResource Theme.Accent}" CornerRadius="3"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock x:Name="ProgressText" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 数据安全说明：用户最担心的就是这一步，明说不覆盖数据 -->
                    <TextBlock x:Name="SafetyHint"
                               Text="更新只替换程序文件：盒子里的文件、盒子布局与设置都会原样保留。"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="打开发布页" Style="{StaticResource GhostButton}"
                                Padding="11,6" FontSize="12" Click="OnOpenReleases"
                                ToolTip="在浏览器中查看所有版本"/>

                        <Button x:Name="PrimaryBtn" Grid.Column="2" Content="立即更新"
                                Style="{StaticResource AccentButton}" Width="96" Height="34"
                                IsDefault="True" Visibility="Collapsed" Click="OnPrimaryClick"/>

                        <Button x:Name="SecondaryBtn" Grid.Column="3" Content="取消"
                                Style="{StaticResource GhostButton}" Width="88" Height="34"
                                Margin="10,0,0,0" IsCancel="True" Click="OnSecondaryClick"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
