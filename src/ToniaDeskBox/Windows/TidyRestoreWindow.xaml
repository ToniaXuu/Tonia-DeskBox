<Window x:Class="ToniaDeskBox.Windows.TidyRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键恢复桌面"
        Icon="{DynamicResource AppIcon}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="24">
        <Border x:Name="ShadowCaster" CornerRadius="14"
                Background="{DynamicResource Theme.ShadowFill}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Border x:Name="ChromeBorder"
                Background="{DynamicResource Theme.Surface}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top"
                           Margin="10,0,10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Theme.Accent}"
                           IsHitTestVisible="False"/>

                <Border x:Name="TitleBar" Grid.Row="0"
                        Background="{DynamicResource Theme.TitleBar}" CornerRadius="13,13,0,0"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                     Fill="{DynamicResource Theme.Accent}"/>
                            <Image Source="{DynamicResource AppIcon}" Width="18" Height="18"/>
                            <TextBlock Text="一键恢复桌面" Foreground="{DynamicResource Theme.Text}"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Click="OnCancel" Cursor="Hand" ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{DynamicResource Theme.Icon}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Danger}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,16,20,18">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Theme.Text}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock x:Name="TimeText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextMuted}"/>

                    <Border Background="{DynamicResource Theme.Fill}" CornerRadius="8"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            Padding="10,8" Margin="0,12,0,0">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ItemList"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="LayoutHint" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondary}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="OkBtn" Content="恢复到桌面" Style="{StaticResource AccentButton}"
                                Width="112" Height="34" IsDefault="True" Click="OnConfirm"/>
                        <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}"
                                Width="88" Height="34" Margin="12,0,0,0" IsCancel="True"
                                Click="OnCancel"/>
                    </StackPanel>
                </StackPanel>

                <!-- 恢复遮罩：还原过程可能几十秒（跨卷会走复制+删除） -->
                <Border x:Name="BusyOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                        Background="#D9000000" CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
                        <TextBlock x:Name="BusyTitle" Text="正在恢复…" HorizontalAlignment="Center"
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="BusyBar" Height="6" Margin="0,16,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     BorderThickness="0" Background="Transparent">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="#40FFFFFF" CornerRadius="3"/>
                                        <Border x:Name="PART_Track"/>
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                Background="{DynamicResource Theme.Accent}" CornerRadius="3"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock x:Name="BusyDetail" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Foreground="#D9FFFFFF" FontSize="11" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BusyCancelBtn" Content="取消" Width="88" Height="30"
                                Margin="0,16,0,0" HorizontalAlignment="Center"
                                Foreground="White" Cursor="Hand" Click="OnCancelRestore">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="6"
                                            BorderBrush="#59FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
