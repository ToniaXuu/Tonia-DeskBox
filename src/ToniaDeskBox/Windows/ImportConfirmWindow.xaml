<Window x:Class="ToniaDeskBox.Windows.ImportConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入备份"
        Icon="{DynamicResource AppIcon}"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="24">
        <Border x:Name="ShadowCaster" CornerRadius="14"
                Background="{DynamicResource Theme.ShadowFill}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Border x:Name="ChromeBorder"
                Background="{DynamicResource Theme.Surface}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top"
                           Margin="10,0,10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Theme.Accent}"
                           IsHitTestVisible="False"/>

                <Border x:Name="TitleBar" Grid.Row="0"
                        Background="{DynamicResource Theme.TitleBar}" CornerRadius="13,13,0,0"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                     Fill="{DynamicResource Theme.Accent}"/>
                            <Image Source="{DynamicResource AppIcon}" Width="18" Height="18"/>
                            <TextBlock Text="导入备份" Foreground="{DynamicResource Theme.Text}"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Click="OnCancel" Cursor="Hand" ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{DynamicResource Theme.Icon}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Danger}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,16,20,18">
                    <!-- 备份包概况 -->
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Theme.Text}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ZipPathText" Margin="0,6,0,0" FontSize="11"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <Border Height="1" Background="{DynamicResource Theme.Divider}" Margin="0,12,0,12"/>

                    <!-- 导入方式：合并只增不删，覆盖会换掉整套数据，代价不同必须显式选 -->
                    <TextBlock Text="导入方式" Foreground="{DynamicResource Theme.TextSecondary}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MergeChip" Content="合并" Style="{StaticResource ThemeChip}"
                                     Tag="Merge" Click="OnModeClick"/>
                        <RadioButton x:Name="ReplaceChip" Content="覆盖" Style="{StaticResource ThemeChip}"
                                     Tag="Replace" Click="OnModeClick"/>
                    </StackPanel>
                    <TextBlock x:Name="ModeHintText" FontSize="11" Margin="0,6,0,12"
                               Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>

                    <TextBlock x:Name="BoxesHeaderText" Text="将导入的盒子"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource Theme.Fill}" CornerRadius="8"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            Padding="10,8">
                        <ScrollViewer x:Name="BoxScroll" MaxHeight="104"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BoxList"/>
                        </ScrollViewer>
                    </Border>

                    <Border Height="1" Background="{DynamicResource Theme.Divider}" Margin="0,12,0,12"/>

                    <!-- 覆盖提醒：说清楚会失去什么、以及失去的东西还在哪 -->
                    <Border x:Name="WarnBorder" Background="{DynamicResource Theme.Fill}" CornerRadius="8"
                            BorderBrush="{DynamicResource Theme.Danger}" BorderThickness="1"
                            Padding="11,9">
                        <StackPanel>
                            <TextBlock x:Name="WarnTitleText" Foreground="{DynamicResource Theme.Text}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WarnDetailText" Margin="0,5,0,0" FontSize="11"
                                       Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="RootNoteText" Margin="0,10,0,0" FontSize="11"
                               Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="OkBtn" Content="开始导入" Style="{StaticResource AccentButton}"
                                Width="100" Height="34" IsDefault="True" Click="OnConfirm"/>
                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                Width="88" Height="34" Margin="12,0,0,0" IsCancel="True"
                                Click="OnCancel"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
