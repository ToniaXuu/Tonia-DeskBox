<Window x:Class="ToniaDeskBox.Windows.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局盒子设置"
        Icon="pack://application:,,,/app.ico"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="24">
        <Border Background="#F2222A38"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="13,13,0,0"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/app.ico" Width="18" Height="18"/>
                            <TextBlock Text="全局盒子设置" Foreground="#F2FFFFFF" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Click="OnClose" Cursor="Hand"
                                ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="#CCFFFFFF" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="透明度" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,0,12,0"
                                Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                                ValueChanged="OnPreviewChanged"/>
                        <TextBox x:Name="OpacityBox" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 ToolTip="范围：0～100（%）"
                                 KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus"/>
                        <TextBlock Grid.Column="2" Text="%" Foreground="#99FFFFFF"
                                   Margin="7,0,0,0" VerticalAlignment="Center" Width="14"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="背景色" Foreground="#99FFFFFF"
                               VerticalAlignment="Top" Margin="0,6,0,14"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="取壁纸近似色" Style="{StaticResource GhostButton}"
                                    Padding="11,5" Click="OnPickWallpaper"/>
                            <Border Grid.Column="2" x:Name="PreviewBorder" Width="52" Height="28"
                                    CornerRadius="7" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    ToolTip="当前外观预览"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="#14FFFFFF" Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="圆角" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RoundedCheck" Content="启用" Style="{StaticResource ModernCheck}"
                                  Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"/>
                        <TextBlock Grid.Column="1" Text="半径" Foreground="#99FFFFFF" Margin="16,0,8,0"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="RadiusSlider" Grid.Column="2" Minimum="0" Maximum="24" Margin="0,0,12,0"
                                Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                                ValueChanged="OnPreviewChanged"/>
                        <TextBox x:Name="RadiusBox" Grid.Column="3" Style="{StaticResource NumberBox}"
                                 ToolTip="范围：0～24（px）"
                                 KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus"/>
                    </Grid>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="#14FFFFFF" Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="毛玻璃" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <CheckBox x:Name="AcrylicCheck" Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernCheck}"
                              Content="Win11 亚克力（Acrylic）" VerticalAlignment="Center" Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="置顶" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,0,18"/>
                    <CheckBox x:Name="TopmostCheck" Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernCheck}"
                              Content="盒子保持在最前" VerticalAlignment="Center" Margin="0,0,0,18"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="确定后立即应用到所有盒子；之后新建的盒子也会使用这套默认值。"
                               Foreground="#66FFFFFF" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OkBtn" Content="确定" Style="{StaticResource AccentButton}"
                                Width="88" Height="34" IsDefault="True" Click="OnOk"/>
                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                Width="88" Height="34" Margin="12,0,0,0" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
