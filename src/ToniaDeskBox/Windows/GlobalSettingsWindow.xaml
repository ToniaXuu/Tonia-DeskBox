<Window x:Class="ToniaDeskBox.Windows.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局盒子设置"
        Icon="{DynamicResource AppIcon}"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <!-- 与「盒子设置」及盒子 / 面板共用同一套 Theme.* 笔刷 -->
    <Grid Margin="24">
        <Border x:Name="ShadowCaster" CornerRadius="14"
                Background="{DynamicResource Theme.ShadowFill}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Border x:Name="ChromeBorder"
                Background="{DynamicResource Theme.Surface}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top"
                           Margin="10,0,10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Theme.Accent}"
                           IsHitTestVisible="False"/>

                <Border x:Name="TitleBar" Grid.Row="0"
                        Background="{DynamicResource Theme.TitleBar}" CornerRadius="13,13,0,0"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                     Fill="{DynamicResource Theme.Accent}"/>
                            <Image Source="{DynamicResource AppIcon}" Width="18" Height="18"/>
                            <TextBlock Text="全局盒子设置" Foreground="{DynamicResource Theme.Text}" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Click="OnClose" Cursor="Hand"
                                ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{DynamicResource Theme.Icon}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Danger}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- 主题：非「自定义」时底色由主题决定，色板不可选 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystemChip" Content="跟随系统" Style="{StaticResource ThemeChip}"
                                         Tag="System" Click="OnThemeChipClick"/>
                            <RadioButton x:Name="ThemeLightChip" Content="浅色" Style="{StaticResource ThemeChip}"
                                         Tag="Light" Click="OnThemeChipClick"/>
                            <RadioButton x:Name="ThemeDarkChip" Content="深色" Style="{StaticResource ThemeChip}"
                                         Tag="Dark" Click="OnThemeChipClick"/>
                            <RadioButton x:Name="ThemeCustomChip" Content="自定义" Style="{StaticResource ThemeChip}"
                                         Tag="Custom" Click="OnThemeChipClick"/>
                        </StackPanel>
                        <TextBlock x:Name="ThemeHintText" FontSize="11" Margin="0,7,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="透明度" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,0,12,0"
                                Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                                ValueChanged="OnPreviewChanged"/>
                        <TextBox x:Name="OpacityBox" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 ToolTip="范围：0～100（%）"
                                 KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus"/>
                        <TextBlock Grid.Column="2" Text="%" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" Width="14"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="菜单" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,0,14"
                               ToolTip="右键菜单 / 托盘菜单的不透明度"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="MenuOpacitySlider" Minimum="0" Maximum="100" Margin="0,0,12,0"
                                Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                                ToolTip="菜单面板的不透明度，独立于盒子；默认比盒子更实，避免叠在卡片上读不清"
                                ValueChanged="OnMenuOpacityChanged"/>
                        <TextBox x:Name="MenuOpacityBox" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 ToolTip="范围：0～100（%）"
                                 KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus"/>
                        <TextBlock Grid.Column="2" Text="%" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" Width="14"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="背景色" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Top" Margin="0,6,0,14"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                        <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WallpaperBtn" Content="取壁纸近似色" Style="{StaticResource GhostButton}"
                                    Padding="11,5" Click="OnPickWallpaper"/>
                            <Border Grid.Column="2" x:Name="PreviewBorder" Width="52" Height="28"
                                    CornerRadius="7" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                    ToolTip="当前外观预览"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource Theme.Divider}" Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="圆角" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,0,14"/>
                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RoundedCheck" Content="启用" Style="{StaticResource ModernCheck}"
                                  Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"/>
                        <TextBlock Grid.Column="1" Text="半径" Foreground="{DynamicResource Theme.TextSecondary}" Margin="16,0,8,0"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="RadiusSlider" Grid.Column="2" Minimum="0" Maximum="24" Margin="0,0,12,0"
                                Style="{StaticResource ModernSlider}" VerticalAlignment="Center"
                                ValueChanged="OnPreviewChanged"/>
                        <TextBox x:Name="RadiusBox" Grid.Column="3" Style="{StaticResource NumberBox}"
                                 ToolTip="范围：0～24（px）"
                                 KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus"/>
                    </Grid>

                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource Theme.Divider}" Margin="0,0,0,14"/>

                    <!-- 外观说明（原毛玻璃开关已移除） -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="底色为半透明纯色（由透明度控制），不做毛玻璃；文字、描边与图标会随底色深浅自动切换对比色。"
                               Foreground="{DynamicResource Theme.TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="置顶" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,0,18"/>
                    <CheckBox x:Name="TopmostCheck" Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernCheck}"
                              Content="盒子保持在最前" VerticalAlignment="Center" Margin="0,0,0,18"/>

                    <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource Theme.Divider}" Margin="0,0,0,14"/>

                    <!-- 存储位置：盒子收纳的是真实文件，可能很大，不能强制留在系统盘 -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="存储" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Top" Margin="0,7,0,14"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Theme.Fill}" CornerRadius="7"
                                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                    Padding="9,6" MinHeight="30">
                                <TextBlock x:Name="StoragePathText" FontSize="12"
                                           Foreground="{DynamicResource Theme.Text}"
                                           TextWrapping="Wrap" MaxHeight="34"/>
                            </Border>
                            <Button Grid.Column="1" Content="更改…" Style="{StaticResource GhostButton}"
                                    Padding="10,5" Margin="8,0,0,0" Click="OnChangeStorage"
                                    ToolTip="选择盒子文件的存放目录，现有文件会自动迁移"/>
                            <Button x:Name="ResetStorageBtn" Grid.Column="2" Content="默认"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,5" Margin="6,0,0,0" Click="OnResetStorage"
                                    ToolTip="恢复到默认存储位置"/>
                        </Grid>
                        <TextBlock x:Name="StorageStatsText" FontSize="11" Margin="0,7,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Height="1"
                            Background="{DynamicResource Theme.Divider}" Margin="0,0,0,14"/>

                    <!-- 全局热键：呼出是每天几十次的动作，不值得每次都找鼠标 -->
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="热键" Foreground="{DynamicResource Theme.TextSecondary}"
                               VerticalAlignment="Top" Margin="0,7,0,14"/>
                    <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,14">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="呼出" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="ShowHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}" Height="30" FontSize="12"
                                     Padding="9,0" VerticalContentAlignment="Center"
                                     ToolTip="点进来后直接按下组合键即可录制"
                                     PreviewKeyDown="OnShowHotkeyKeyDown"
                                     GotKeyboardFocus="OnHotkeyBoxFocus"/>
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource GhostButton}"
                                    Padding="9,4" Margin="8,0,0,0" FontSize="12"
                                    Click="OnClearShowHotkey"
                                    ToolTip="清除后不再注册呼出热键"/>
                            <TextBlock Grid.Column="3" Text="呼出全部盒子并置顶"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="收起" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="HideHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}" Height="30" FontSize="12"
                                     Padding="9,0" VerticalContentAlignment="Center"
                                     ToolTip="点进来后直接按下组合键即可录制"
                                     PreviewKeyDown="OnHideHotkeyKeyDown"
                                     GotKeyboardFocus="OnHotkeyBoxFocus"/>
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource GhostButton}"
                                    Padding="9,4" Margin="8,0,0,0" FontSize="12"
                                    Click="OnClearHideHotkey"
                                    ToolTip="留空表示不占用这个键位"/>
                            <TextBlock Grid.Column="3" Text="收起全部盒子（可选）"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="HotkeyHintText" FontSize="11" Margin="0,7,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="确定后立即应用到所有盒子；之后新建的盒子也会使用这套默认值。"
                               Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OkBtn" Content="确定" Style="{StaticResource AccentButton}"
                                Width="88" Height="34" IsDefault="True" Click="OnOk"/>
                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                Width="88" Height="34" Margin="12,0,0,0" IsCancel="True"
                                Click="OnCancelTheme"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 迁移遮罩：压住整窗，避免迁移途中改设置或关窗 -->
        <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#D9000000" CornerRadius="14">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="330">
                <TextBlock x:Name="BusyTitle" Text="正在迁移…" HorizontalAlignment="Center"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <ProgressBar x:Name="BusyBar" Height="6" Margin="0,16,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             BorderThickness="0" Background="Transparent">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="#40FFFFFF" CornerRadius="3"/>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Accent}" CornerRadius="3"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="BusyDetail" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="#D9FFFFFF" FontSize="11" TextAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BusyCancelBtn" Content="取消" Width="88" Height="30"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Foreground="White" Cursor="Hand" Click="OnCancelMigration">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="6"
                                    BorderBrush="#59FFFFFF" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
