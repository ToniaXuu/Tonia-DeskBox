<Window x:Class="ToniaDeskBox.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="470"
        PreviewKeyDown="OnPanelPreviewKeyDown"
        Deactivated="OnPanelDeactivated">
    <Window.Resources>
        <Style x:Key="MoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-5,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 外圈透明边距给投影留渲染空间（分层窗口 alpha=0 区域天然点击穿透） -->
    <Grid Margin="18">
        <Border x:Name="Root"
                Background="#F21A1F2A"
                CornerRadius="14"
                Padding="10"
                BorderThickness="1"
                BorderBrush="#22FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                  Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        <StackPanel>
            <DockPanel Margin="4,0,2,8">
                <Button x:Name="MoreButton"
                        DockPanel.Dock="Right"
                        Content="⋯"
                        Click="OnMoreClick"
                        Style="{StaticResource MoreButtonStyle}"/>
                <TextBlock x:Name="PanelTitle"
                           Foreground="#B3FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="EmptyHint"
                       Text="把桌面图标拖到盒子上收纳"
                       Foreground="#80FFFFFF"
                       FontSize="12"
                       Margin="10,8"
                       HorizontalAlignment="Center"/>
            <ScrollViewer MaxHeight="440" MaxWidth="400"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="BandHost" Background="Transparent"
                      MouseLeftButtonDown="OnBandMouseDown"
                      MouseMove="OnBandMouseMove"
                      MouseLeftButtonUp="OnBandMouseUp">
                    <Rectangle x:Name="Band"
                               Fill="#1F6E8BFF"
                               Stroke="#996E8BFF"
                               StrokeThickness="1"
                               RadiusX="2" RadiusY="2"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="80" Height="92" Margin="4"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="OnItemMouseLeftButtonDown"
                                      MouseMove="OnItemMouseMove"
                                      MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                                      MouseRightButtonDown="OnItemRightButtonDown">
                                    <Border x:Name="SelBg"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="44" Height="44"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#EEFFFFFF"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,5,0,0"
                                                   VerticalAlignment="Top"
                                                   ToolTip="{Binding DisplayName}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CheckMark"
                                               Text="✓"
                                               Foreground="#FF9DB4FF"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Margin="0,3,5,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="SelBg" Property="Background" Value="#14FFFFFF"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelBg" Property="Background" Value="#336E8BFF"/>
                                        <Setter TargetName="SelBg" Property="BorderBrush" Value="#996E8BFF"/>
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </StackPanel>
        </Border>
    </Grid>
</Window>
