<Window x:Class="ToniaDeskBox.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Root"
            Background="#1F2A30"
            CornerRadius="8"
            Padding="8"
            BorderThickness="1"
            BorderBrush="#33FFFFFF">
        <StackPanel>
            <TextBlock x:Name="EmptyHint"
                       Text="把桌面图标拖到盒子上收纳"
                       Foreground="#88FFFFFF"
                       FontSize="12"
                       Margin="10,8"
                       HorizontalAlignment="Center"/>
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="80" Height="92" Margin="4"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="OnItemMouseLeftButtonDown"
                                  MouseMove="OnItemMouseMove"
                                  MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                                  MouseRightButtonDown="OnItemRightButtonDown">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Image Source="{Binding Icon}"
                                       Width="44" Height="44"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="#EEFFFFFF"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="32"
                                           Margin="0,4,0,0"
                                           VerticalAlignment="Top"
                                           ToolTip="{Binding DisplayName}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
