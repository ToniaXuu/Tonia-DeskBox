<Window x:Class="ToniaDeskBox.Windows.BoxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="盒子设置"
        Width="400"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" MinWidth="280"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="透明度" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Width="220"
                    VerticalAlignment="Center" ValueChanged="OnPreviewChanged"/>
            <TextBlock x:Name="OpacityText" Text="85%" Margin="10,0,0,0" VerticalAlignment="Center" Width="40"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="背景色" VerticalAlignment="Top" Margin="0,4,12,10"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="WallpaperBtn" Content="取壁纸近似色" Padding="8,3" Click="OnPickWallpaper"/>
                <Border x:Name="PreviewBorder" Width="64" Height="24" Margin="10,0,0,0"
                        BorderBrush="#88000000" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="预览" FontSize="10" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="圆角" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="RoundedCheck" Content="启用" VerticalAlignment="Center" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"/>
            <TextBlock Text="半径" Margin="14,0,6,0" VerticalAlignment="Center"/>
            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24" Width="140"
                    VerticalAlignment="Center" ValueChanged="OnPreviewChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="毛玻璃" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <CheckBox x:Name="AcrylicCheck" Grid.Row="4" Grid.Column="1" Content="Win11 亚克力（Acrylic）" VerticalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="置顶" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <CheckBox x:Name="TopmostCheck" Grid.Row="5" Grid.Column="1" Content="盒子保持在最前" VerticalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="OkBtn" Content="确定" Width="72" Padding="0,4" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="72" Padding="0,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
