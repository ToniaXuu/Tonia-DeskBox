<Window x:Class="ToniaDeskBox.Windows.BoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Box"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SourceInitialized="OnSourceInitialized">
    <Border x:Name="RootBorder"
            Background="#1F2A30"
            CornerRadius="8"
            Padding="16,9"
            BorderThickness="2"
            BorderBrush="Transparent"
            AllowDrop="True"
            Drop="OnDrop"
            DragEnter="OnDragEnter"
            DragLeave="OnDragLeave"
            MouseLeftButtonDown="OnBoxMouseLeftButtonDown"
            MouseRightButtonDown="OnBoxMouseRightButtonDown"
            Cursor="Hand">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="NameText"
                       Foreground="#DDFFFFFF"
                       FontSize="13"
                       VerticalAlignment="Center"/>
            <Border x:Name="BadgeBorder"
                    Background="#E0607488"
                    CornerRadius="9"
                    MinWidth="18"
                    Height="18"
                    Margin="9,0,0,0"
                    Padding="5,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="CountText"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
